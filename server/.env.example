# Configuration du Serveur Node.js Iventello
PORT=4000
NODE_ENV=development

# Clé secrète JWT
JWT_SECRET=iventello_super_secret_jwt_key_2026

# Configuration Expédition Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@iventello.com
SMTP_PASS=app_password_here
SMTP_FROM_NAME="Iventello Sécurité"
SMTP_FROM_EMAIL=noreply@iventello.com

# Configuration Expédition SMS (Optionnel / Passerelle API)
SMS_API_URL=https://api.sms-gateway.com/v1/send
SMS_API_KEY=your_sms_api_key
SMS_SENDER_ID=IVENTELLO

# Paramètres OTP de Sécurité
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
