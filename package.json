{
  "name": "Iventello",
  "version": "1.0.3",
  "description": "Application de gestion de stock et de caisse (Offline Desktop)",
  "main": "./out/main/index.js",
  "author": "RUXEL DJEUTCHOU <djeutchouruxel@exemple.com>",
  "scripts": {
    "dev": "cross-env ELECTRON_DISABLE_SANDBOX=1 ELECTRON_DISABLE_GPU=1 electron-vite dev",
    "build": "electron-vite build && node -e \"require('fs').cpSync('src/assets/favicon.ico','out/renderer/favicon.ico');require('fs').cpSync('src/assets/iventello.png','out/renderer/iventello.png')\"",
    "preview": "electron-vite preview",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "dist": "prisma generate && node -e \"const fs=require('fs');fs.cpSync('node_modules/.prisma/client','node_modules/@prisma/client/.prisma/client',{recursive:true})\" && npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --pretty",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:dev": "npm --prefix server run dev",
    "server:start": "npm --prefix server start"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tanstack/react-query": "^5.102.8",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "canvas": "^3.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.4",
    "electron-pos-printer": "^1.3.8",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.2.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "pdfkit": "^0.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^3.9.2",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^2.2.0",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
